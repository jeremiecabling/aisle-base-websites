# ─── Platform env vars ───────────────────────────────────────────────────────
# Set ONCE on the single Vercel project. Never per client (HANDOFF §7.1).
# Generate secrets with: openssl rand -hex 32
# Store real values in your password manager; NEVER commit them.

# Apps Script web-app /exec URL (the ONE bound deployment).
# Reminder: ship script updates via Manage deployments → Edit → New version.
# Creating a NEW deployment changes this URL and strands the platform.
PLATFORM_API_URL=

# Shared secret between Next.js and the Apps Script.
# Must equal the script's PLATFORM_SECRET Script Property.
# NOTE (addendum Q20, accepted by design): this travels as a GET query param
# because Next's data cache only caches GET fetches. Do not "fix" this by
# switching to POST — it would break revalidate/revalidateTag freshness.
PLATFORM_API_SECRET=

# HMAC key for password-gate cookies (lib/gate-token.ts).
# There is deliberately NO fallback to the guest password (HANDOFF §5 bug 7).
GATE_SIGNING_SECRET=

# Secret for GET /api/revalidate?site=<slug>&secret=<this>
REVALIDATE_SECRET=

# Contact link on the apex landing (omit to hide the link until Q9 closes).
# Build-time inlined like all NEXT_PUBLIC_* vars.
NEXT_PUBLIC_CONTACT_EMAIL=

# The wildcard subdomain base tenant sites live under, e.g. sites.aislebase.com
# (⚠ addendum Q9: the real apex domain is still an open decision).
# NEXT_PUBLIC_* is inlined at BUILD time — set it in Vercel BEFORE deploying;
# changing it requires a redeploy, not just an env edit.
NEXT_PUBLIC_SUBDOMAIN_BASE=
